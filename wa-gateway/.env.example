# Dibuat otomatis oleh install.sh (WA_GATEWAY=1). Jangan commit file .env.

# Port gateway, hanya bisa dibuka dari server ini (HOST=127.0.0.1).
PORT=3001
HOST=127.0.0.1

# Kunci untuk endpoint /groups, /send, /kirim-rekap (header X-Api-Key).
API_KEY=

# ID grup WA tujuan, bentuknya seperti 120207123456789012@g.us
# Cari lewat: curl -H "X-Api-Key: <API_KEY>" http://127.0.0.1:3001/groups
GROUP_JID=

# 3 sesi, jeda 30 menit, Senin-Jumat (waktu mengikuti TIMEZONE).
CRON_SCHEDULE=15 7 * * 1-5;45 7 * * 1-5;15 8 * * 1-5
TIMEZONE=Asia/Makassar
SCHEDULER_ENABLED=true

# true: tetap kirim pesan saat belum ada izin disetujui hari ini.
SEND_IF_EMPTY=false

# Endpoint aplikasi IzinSiswa dan tokennya (sama dengan WA_REKAP_TOKEN di web/.env).
IZIN_API_URL=http://127.0.0.1:3000/api/integrations/wa-rekap
IZIN_API_TOKEN=
