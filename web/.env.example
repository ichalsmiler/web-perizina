# Copy this file to .env and fill in real values.
# Unquoted values are used deliberately so this file can also be loaded
# directly by systemd's EnvironmentFile= (see deploy/izinsiswa.service).

# Local/SQLite (default for this prototype):
DATABASE_URL=file:./dev.db
# Postgres (production), example:
# DATABASE_URL=postgresql://user:password@localhost:5432/izinsiswa

# Required in every environment. Generate with: openssl rand -base64 48
# Keep this value server-side; never use a NEXT_PUBLIC_ prefix for secrets.
JWT_SECRET=

# Optional private Telegram delivery. Enable only after configuring your bot
# and personal chat ID on the server. Never use NEXT_PUBLIC_ for these values.
TELEGRAM_REPORT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
