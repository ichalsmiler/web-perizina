# Copy this file to .env and fill in real values.
# Unquoted values are used deliberately so this file can also be loaded
# directly by systemd's EnvironmentFile= (see deploy/izinsiswa.service).

# Local/SQLite (default for this prototype):
DATABASE_URL=file:./dev.db
# Postgres (production), example:
# DATABASE_URL=postgresql://user:password@localhost:5432/izinsiswa

# Generate a strong random value in production, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
