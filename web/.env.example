# Copy this file to .env and fill in real values.
# Unquoted values are used deliberately so this file can also be loaded
# directly by systemd's EnvironmentFile= (see the service written by install.sh).

# Local/SQLite (default for this prototype):
DATABASE_URL=file:./dev.db
# Postgres (production), example:
# DATABASE_URL=postgresql://user:password@localhost:5432/izinsiswa

# Generate a strong random value in production, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Optional: shared token for GET /api/integrations/wa-rekap, used by wa-gateway.
# install.sh with WA_GATEWAY=1 fills this in. Empty = endpoint disabled (503).
# WA_REKAP_TOKEN=
